<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="398.0" prefWidth="700.0" style="-fx-background-color: transparent;" stylesheets="@../CSS/console-style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DesktopConsole.ConsoleView">
   <children>
      <ImageView fitHeight="647.0" fitWidth="700.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-color: transparent;">
         <image>
            <Image url="@../images/Personal%20Dashboard%20Final.png" />
         </image>
      </ImageView>
      <Label fx:id="infoLabel" alignment="CENTER" contentDisplay="TOP" layoutX="98.0" layoutY="284.0" prefHeight="24.0" prefWidth="497.0" text="Autumn Skies Online" textAlignment="CENTER" textFill="#6b6b6b">
         <font>
            <Font name="Nunito Bold" size="24.0" />
         </font>
      </Label>
      <Label fx:id="dayLabel" layoutX="86.0" layoutY="84.0" prefHeight="62.0" prefWidth="264.0" styleClass="left-display" text="Wednesday" textFill="#474747">
         <font>
            <Font name="Roboto Medium" size="45.0" />
         </font>
      </Label>
      <Label fx:id="dateLabel" layoutX="84.0" layoutY="132.0" prefHeight="62.0" prefWidth="236.0" styleClass="left-display" text="12 Nov 2026" textFill="#474747">
         <font>
            <Font name="Roboto Medium" size="35.0" />
         </font>
      </Label>
      <Label fx:id="timeLabel" layoutX="84.0" layoutY="183.0" prefHeight="62.0" prefWidth="223.0" styleClass="left-display" text="14:52" textFill="#474747">
         <font>
            <Font name="Roboto Medium" size="45.0" />
         </font>
      </Label>
      <ImageView fx:id="weatherIcon" fitHeight="114.0" fitWidth="114.0" layoutX="375.0" layoutY="76.0" pickOnBounds="true" preserveRatio="true" scaleX="0.96" scaleY="0.96">
         <image>
            <Image url="@../images/Partly-Cloudy-Day.png" />
         </image>
      </ImageView>
      <Label fx:id="currentTemp" layoutX="493.0" layoutY="99.0" prefHeight="67.0" prefWidth="134.0" text="34°C" textFill="#474747">
         <font>
            <Font name="Roboto Medium" size="40.0" />
         </font>
      </Label>
      <Label fx:id="minTemp" layoutX="450.0" layoutY="187.0" text="21°C" textFill="#474747">
         <font>
            <Font name="Roboto Medium" size="25.0" />
         </font>
      </Label>
      <Label fx:id="maxTemp" layoutX="450.0" layoutY="218.0" text="37°C" textFill="#474747">
         <font>
            <Font name="Roboto Medium" size="25.0" />
         </font>
      </Label>
      <AnchorPane fx:id="dragZone" prefHeight="50.0" prefWidth="700.0" style="fx-bakground-color: transparent;" />
      <Button fx:id="closeButton" alignment="CENTER" contentDisplay="CENTER" layoutX="660.0" layoutY="4.0" mnemonicParsing="false" onAction="#onCloseClicked" prefHeight="22.0" prefWidth="37.0" styleClass="close-Button" stylesheets="@../FXML/DesktopConsole.fxml" text="X">
         <font>
            <Font name="Nunito Bold" size="18.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
